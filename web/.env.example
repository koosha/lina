# Build-time configuration for the Lina sandbox UI.
# Copy to `.env.local` before `npm run build`.

# API Gateway endpoint (no trailing slash — `/ask` is appended at request time).
VITE_LINA_API_BASE=https://kfrbjzy4l7.execute-api.us-east-1.amazonaws.com

# API key issued by the sandbox authorizer. Note: this value ships in the
# client bundle. Sandbox-grade only — rotate the key if the bundle leaks
# beyond your trusted demo audience.
VITE_LINA_API_KEY=

# Demo user_id sent in every request. The supervisor uses this to resolve a
# CallerContext via Subsystem A. Should match a seeded user.
VITE_LINA_USER_ID=user_jane_smith

# Hardcoded passphrase that gates the landing page. Leave blank to disable.
VITE_LINA_PASSPHRASE=

# First-name shown in the landing greeting.
VITE_LINA_FIRST_NAME=Jane
